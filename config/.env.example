# .env.example — скопируй в config/.env и заполни СВОИМИ значениями.
# config/.env в .gitignore — креды НИКОГДА не попадают в репозиторий.
# Загружается автоматически (python-dotenv) при запуске worker.py, либо через
# systemd EnvironmentFile.

# --- Маркетинговый кабинет (ставки) — marketing.kaspi.kz ---
# Официального API нет: логинимся логином+паролем через Playwright, работаем по кукам.
KASPI_MARKETING_LOGIN=your-login@example.com
KASPI_MARKETING_PASSWORD=your-password
KASPI_MARKETING_MERCHANT_ID=832398        # merchantId маркетинга
# (устарело) KASPI_CAMPAIGN_ID больше не используется воркером.
# Охват кампаний задаётся ниже; пусто = вести ВСЕ активные (Enabled).
KASPI_CAMPAIGN_IDS=                        # список id через запятую, напр. 2899523,3032419

# --- Основной кабинет продавца (выручка) — Shop API kaspi.kz/shop/api/v2 ---
# Статичный токен из кабинета: Настройки → API. Не протухает.
KASPI_MERCHANT_TOKEN=your-shop-api-token

# --- LLM-аналитик (опционально; дневной разбор) ---
ANTHROPIC_API_KEY=your-anthropic-key

# --- Подневные метрики для графиков панели ---
# Раз в час опрашивает кабинет по каждому дню отдельно (сегодня и вчера) и
# складывает CTR/CR/ROAS в metrics_daily. Кабинет — 2 запроса на кампанию на
# день. Shop API — ДВА ПОЛНЫХ ОБХОДА заказов в час (по одному на каждый
# обрабатываемый день): постраничный список заказов плюс отдельный запрос
# состава на КАЖДЫЙ заказ. Это примерно удваивает нагрузку на Shop API
# относительно уже существующего revenue-цикла. 0 — выключить, графики
# перестанут наполняться, ставочные контуры не затронуты.
DAILY_METRICS_ENABLED=1

# --- Пути и файлы (можно оставить дефолты) ---
DB_PATH=db/autopilot.db
STORAGE_STATE=storage_state.json          # кэш куки-сессии маркетинга (в .gitignore)
RULES_CONFIG=config/rules.yaml

# --- Веб-панель (webui) ---
UI_USERNAME=admin
UI_PASSWORD_HASH=            # получить: .venv/bin/python -c "from webui.auth import hash_password; print(hash_password('ТВОЙ_ПАРОЛЬ'))"
UI_SECRET_KEY=              # случайная строка: .venv/bin/python -c "import secrets; print(secrets.token_hex(32))"
