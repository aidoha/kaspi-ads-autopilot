# systemd-юнит для 24/7 работы автопилота на VPS.
# Установка:
#   sudo cp deploy/kaspi-autopilot.service /etc/systemd/system/
#   отредактируй User/WorkingDirectory/ExecStart под свои пути
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kaspi-autopilot
# Логи:  journalctl -u kaspi-autopilot -f
#
# ВАЖНО: креды НЕ через systemd EnvironmentFile — он НЕ срезает инлайн-
# комментарии (KASPI_...=832398  # ...), и значение ушло бы вместе с "# ...".
# Вместо этого worker.py сам грузит config/.env через python-dotenv (dotenv
# комментарии срезает). Путь к .env задаём через ENV_FILE ниже.

[Unit]
Description=Kaspi Ads Autopilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kaspi
WorkingDirectory=/opt/kaspi-ads-autopilot
Environment=ENV_FILE=/opt/kaspi-ads-autopilot/config/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/kaspi-ads-autopilot/.venv/bin/python worker.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
